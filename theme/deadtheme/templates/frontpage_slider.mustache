<div class="eskada-slider" id="eskadaSlider" role="region" aria-roledescription="carrossel" aria-label="Destaques">
  {{#slides}}
  <div class="eskada-slide{{#active}} active{{/active}}">
    <img src="{{image}}" alt="{{alt}}">
  </div>
  {{/slides}}
  <div class="eskada-slider-nav">
    <button type="button" class="eskada-pause" aria-label="Pausar apresentação de slides">
      <i class="fa fa-pause" aria-hidden="true"></i>
    </button>
    {{#slides}}
    <button type="button" class="eskada-dot"></button>
    {{/slides}}
  </div>
</div>

{{#js}}
require(['jquery'], function($) {
    var slides = $('#eskadaSlider .eskada-slide');
    var dots = $('#eskadaSlider .eskada-dot');
    var pauseBtn = $('#eskadaSlider .eskada-pause');
    var current = 0, timer = null;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    dots.each(function(i) { $(this).attr('aria-label', 'Ir para o slide ' + (i + 1)); });

    function showSlide(i) {
        current = i;
        slides.removeClass('active'); dots.removeClass('active');
        slides.eq(i).addClass('active'); dots.eq(i).addClass('active');
    }
    function play() {
        timer = setInterval(function() { showSlide((current + 1) % slides.length); }, 4000);
        pauseBtn.attr('aria-label', 'Pausar apresentação de slides')
                .find('i').attr('class', 'fa fa-pause');
    }
    function stop() {
        clearInterval(timer); timer = null;
        pauseBtn.attr('aria-label', 'Retomar apresentação de slides')
                .find('i').attr('class', 'fa fa-play');
    }

    showSlide(0);
    if (!reduce) { play(); } else { stop(); }
    pauseBtn.on('click', function() { timer ? stop() : play(); });
    dots.on('click', function() { showSlide(dots.index(this)); });
});
{{/js}}